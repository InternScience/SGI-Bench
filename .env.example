# OpenAI-compatible API settings for model inference and judging.
OPENAI_API_KEY="sk-your-api-key"
OPENAI_BASE_URL="http://your-openai-compatible-endpoint/v1"

# Hugging Face dataset access token for gated SGI-Bench datasets.
#
# How to get access:
# 1. Log in to Hugging Face and open the SGI-Bench dataset page.
# 2. Click the button to agree to share your contact information.
#    This gate is automatic; there is no manual approval wait.
#    It only prevents evaluated agents from finding benchmark questions
#    directly through web search during evaluation.
# 3. Create a read-only token at https://huggingface.co/settings/tokens
#    and paste it here.
HF_TOKEN="hf-your-read-token"
